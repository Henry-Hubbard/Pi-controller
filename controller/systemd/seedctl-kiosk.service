[Unit]
Description=Seed Drop Controller screen (cage + Chromium)
After=systemd-user-sessions.service seedctl-setup.service plymouth-quit-wait.service systemd-logind.service
Wants=seedctl-setup.service systemd-logind.service
# Take over the first console instead of a login prompt.
Conflicts=getty@tty1.service
After=getty@tty1.service
# Put seedctl-off on the SD card's boot partition to boot to a login prompt instead.
ConditionPathExists=!/boot/firmware/seedctl-off
ConditionPathExists=!/boot/seedctl-off
# If the screen app fails 4 times in 2 minutes, stop retrying and show a login prompt.
StartLimitIntervalSec=120
StartLimitBurst=4
OnFailure=getty@tty1.service

[Service]
Type=simple
User=seedctl
PAMName=seedctl-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/opt/seedctl/bin/seedctl-cage
# Every time it stops, copy the log to the SD card (seedctl-log.txt).
ExecStopPost=+/opt/seedctl/bin/seedctl-savelog
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
